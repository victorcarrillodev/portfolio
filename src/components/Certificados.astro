---
// Aquí debes colocar las rutas reales de tus certificados.
// Recuerda usar /portfolio/ si están en la carpeta public, o importarlos si están en src.
const certificados = [
  {
    id: 1,
    title: 'freeCodeCamp JavaScript',
    // Imagen de ejemplo: 800x600 (horizontal)
    image: 'https://placehold.co/800x600/ffffff/000000?text=Certificado+JavaScript',
  },
  {
    id: 2,
    title: 'Fundamentos de Linux',
    // Imagen de ejemplo: 800x1000 (vertical para que se note el estilo Pinterest)
    image: 'https://placehold.co/800x1000/ffffff/000000?text=Fundamentos+de+Linux',
  },
  {
    id: 3,
    title: 'Linux Unhatched',
    // Imagen de ejemplo: 800x700
    image: 'https://placehold.co/800x700/ffffff/000000?text=Linux+Unhatched',
  },
  {
    id: 4,
    title: 'Fundamentos de Linux 2',
    // Imagen de ejemplo: 800x600
    image: 'https://placehold.co/800x600/ffffff/000000?text=Linux+Fundamentos+2',
  },
  {
    id: 5,
    title: 'Fundamentos de Linux 3',
    // Imagen de ejemplo: 800x1100 (vertical)
    image: 'https://placehold.co/800x1100/ffffff/000000?text=Linux+Fundamentos+3',
  },
]
---

<section class='relative bg-[#e5e5e5] min-h-screen py-24 overflow-hidden'>
  <div
    class='absolute top-0 left-10 w-48 h-64 bg-[#a600ff] z-0'
    style='clip-path: polygon(50% 0%, 0% 100%, 100% 100%);'
  >
  </div>

  <div
    class='absolute top-20 right-20 w-24 h-24 bg-[#ff8c00] z-0'
    style='clip-path: polygon(50% 0%, 0% 100%, 100% 100%);'
  >
  </div>

  <div class='absolute top-1/3 right-0 w-32 h-3/4 bg-[#ff3b30] z-0'></div>

  <div class='absolute bottom-0 left-10 w-64 h-48 bg-[#007aff] z-0'></div>
  <div class='absolute bottom-0 left-0 w-32 h-64 bg-[#005bb5] z-0' style='clip-path: polygon(0 0, 100% 100%, 0 100%);'>
  </div>

  <div class='absolute top-24 right-0 w-96 h-48 opacity-60 z-0 pointer-events-none text-[#00aaff]'>
    <svg width='100%' height='100%' viewBox='0 0 200 100' xmlns='http://www.w3.org/2000/svg'>
      <path d='M0,20 Q25,40 50,20 T100,20 T150,20 T200,20' fill='none' stroke='currentColor' stroke-width='3'></path>
      <path d='M0,40 Q25,60 50,40 T100,40 T150,40 T200,40' fill='none' stroke='currentColor' stroke-width='3'></path>
      <path d='M0,60 Q25,80 50,60 T100,60 T150,60 T200,60' fill='none' stroke='currentColor' stroke-width='3'></path>
    </svg>
  </div>

  <div class='absolute bottom-10 left-0 w-96 h-48 opacity-60 z-0 pointer-events-none text-[#00aaff]'>
    <svg width='100%' height='100%' viewBox='0 0 200 100' xmlns='http://www.w3.org/2000/svg'>
      <path d='M0,20 Q25,0 50,20 T100,20 T150,20 T200,20' fill='none' stroke='currentColor' stroke-width='3'></path>
      <path d='M0,40 Q25,20 50,40 T100,40 T150,40 T200,40' fill='none' stroke='currentColor' stroke-width='3'></path>
      <path d='M0,60 Q25,40 50,60 T100,60 T150,60 T200,60' fill='none' stroke='currentColor' stroke-width='3'></path>
    </svg>
  </div>

  <div class='relative z-10 container mx-auto px-6 lg:px-16 max-w-7xl'>
    <h2 class='text-5xl md:text-7xl font-extrabold text-black mb-16 tracking-tight'>Certificados</h2>

    <div class='columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6'>
      {
        certificados.map((cert) => (
          /* break-inside-avoid es la clave aquí: 
          Evita que la tarjeta se corte por la mitad cuando cambia de columna.
        */
          <div class='break-inside-avoid bg-white rounded-xl shadow-xl p-3 border border-gray-100 hover:scale-[1.02] transition-transform duration-300'>
            <img
              src={cert.image}
              alt={`Certificado de ${cert.title}`}
              class='w-full h-auto object-cover rounded-lg border border-gray-200'
              loading='lazy'
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @reference 'tailwindcss';
</style>
