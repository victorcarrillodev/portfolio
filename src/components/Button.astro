---
interface Props {
  color?: keyof typeof Colors
  styled?: keyof typeof Styles
  behavior?: keyof typeof Behaviors
  size?: keyof typeof Sizes
  modifier?: keyof typeof Modifiers
  class?: string
}

const Colors = {
  neutral: 'btn-neutral',
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  accent: 'btn-accent',
  info: 'btn-info',
  success: 'btn-success',
  warning: 'btn-warning',
  error: 'btn-error',
}

const Styles = {
  outline: 'btn-outline',
  dash: 'btn-dash',
  soft: 'btn-soft',
  ghost: 'btn-ghost',
  link: 'btn-link',
  null: null,
}

const Behaviors = {
  active: 'btn-active',
  disabled: 'btn-disabled',
}
const Sizes = {
  xs: 'btn-xs',
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg',
}
const Modifiers = {
  wide: 'btn-wide',
  block: 'btn-block',
  square: 'btn-square',
  circle: 'btn-circle',
}

const { color = 'primary', styled: style = 'null', behavior, size, modifier, class: className } = Astro.props
const isColor = Colors[color]
const isStyle = style ? Styles[style] : undefined
const isBehavior = behavior ? Behaviors[behavior] : undefined
const isSize = size ? Sizes[size] : undefined
const isModifier = modifier ? Modifiers[modifier] : undefined
---

<button class:list={['btn std__shadow', isColor, isStyle, isBehavior, isSize, isModifier, className]}>
  <slot />
</button>

<style is:global>
  @reference 'tailwindcss';

  .btn-outline {
    @apply border-3;
  }
</style>
