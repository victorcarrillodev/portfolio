---
// Importa el componente Image para optimización si lo deseas
import { Image } from 'astro:assets'

// Importamos el archivo de fondo exacto
import backgroundBlobs from '../assets/images/Skills.svg'
import Container from './Container.astro'

// Asumimos que tienes los iconos en src/assets/images/icons/
const skillCategories = [
  {
    title: 'Frontend',
    skills: [
      { name: 'HTML5', icon: '/src/assets/icons/html5.svg' },
      { name: 'CSS3', icon: '/src/assets/icons/css3.svg' },
      { name: 'JavaScript', icon: '/src/assets/icons/javascript.svg' },
      { name: 'TypeScript', icon: '/src/assets/icons/typescript.svg' },
      { name: 'React', icon: '/src/assets/icons/react.svg' },
      { name: 'Angular', icon: '/src/assets/icons/angular.svg' },
      { name: 'Vue', icon: '/src/assets/icons/vue.svg' },
      { name: 'Astro', icon: '/src/assets/icons/astro.svg' },
    ],
  },
  {
    title: 'Backend',
    skills: [
      { name: 'Express', icon: '/src/assets/icons/express.svg' },
      { name: 'NestJS', icon: '/src/assets/icons/nestjs.svg' },
      { name: 'Django', icon: '/src/assets/icons/django.svg' },
      { name: 'PHP', icon: '/src/assets/icons/php.svg' },
      { name: 'PostgreSQL', icon: '/src/assets/icons/postgresql.svg' },
      { name: 'Redis', icon: '/src/assets/icons/redis.svg' },
      { name: 'Node.js', icon: '/src/assets/icons/nodejs.svg' },
      { name: 'MongoDB', icon: '/src/assets/icons/mongodb.svg' },
      { name: 'Python', icon: '/src/assets/icons/python.svg' },
    ],
  },
  {
    title: 'Mobile',
    skills: [
      { name: 'Flutter', icon: '/src/assets/icons/flutter.svg' },
      { name: 'Dart', icon: '/src/assets/icons/dart.svg' },
    ],
  },
  {
    title: 'CI/CD - DevOps',
    skills: [
      { name: 'GitLab CI', icon: '/src/assets/icons/gitlabci.svg' },
      { name: 'Jenkins', icon: '/src/assets/icons/jenkins.svg' },
      { name: 'GitLab', icon: '/src/assets/icons/gitlab.svg' },
      { name: 'Docker', icon: '/src/assets/icons/docker.svg' },
    ],
  },
]
---

<section class='relative bg-white text-black overflow-hidden min-h-screen py-23'>
  <Container maxWidth='xl'>
    <img
      src={backgroundBlobs.src}
      alt='Fondo decorativo'
      class='absolute inset-0 z-0 w-full h-full object-cover pointer-events-none'
      aria-hidden='true'
    />

    <div class='relative z-10 container'>
      <h2 class='std__title tracking-tight text-black'>Skills</h2>

      <div class='space-y-9'>
        {
          skillCategories.map((category) => (
            <div class='space-y-3'>
              <h3 class='text-3xl font-bold uppercase tracking-wider text-black'>{category.title}</h3>

              <div class='flex flex-wrap gap-4 items-center'>
                {category.skills.map((skill) => (
                  <div class='std__shadow bg-gray-200 rounded-xl shadow-lg p-1 w-[5vw] h-[5vw] flex items-center justify-center hover:scale-105 transition-transform duration-200'>
                    <img src={skill.icon} alt={skill.name} class='w-17 h-17 object-contain' />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  /* Referencia a Tailwind para autocompletado en algunos editores */
  @reference 'tailwindcss';

  /* Pequeños retoques visuales adicionales */
  img.object-contain {
    max-width: 100%;
    max-height: 100%;
  }
</style>
