---
import backgroundBlobs from '../assets/images/Skills.svg'
import Container from './Container.astro'

// FRONTEND
import html5Icon from '../assets/icons/html5.svg'
import css3Icon from '../assets/icons/css3.svg'
import javascriptIcon from '../assets/icons/javascript.svg'
import typescriptIcon from '../assets/icons/typescript.svg'
import reactIcon from '../assets/icons/react.svg'
import angularIcon from '../assets/icons/angular.svg'
import vueIcon from '../assets/icons/vue.svg'
import astroIcon from '../assets/icons/astro.svg'

// BACKEND
import expressIcon from '../assets/icons/express.svg'
import nestjsIcon from '../assets/icons/nestjs.svg'
import djangoIcon from '../assets/icons/django.svg'
import phpIcon from '../assets/icons/php.svg'
import postgresqlIcon from '../assets/icons/postgresql.svg'
import redisIcon from '../assets/icons/redis.svg'
import nodejsIcon from '../assets/icons/nodejs.svg'
import mongodbIcon from '../assets/icons/mongodb.svg'
import pythonIcon from '../assets/icons/python.svg'

// MOBILE
import flutterIcon from '../assets/icons/flutter.svg'
import dartIcon from '../assets/icons/dart.svg'

// DEVOPS
import gitlabciIcon from '../assets/icons/gitlabci.svg'
import jenkinsIcon from '../assets/icons/jenkins.svg'
import gitlabIcon from '../assets/icons/gitlab.svg'
import dockerIcon from '../assets/icons/docker.svg'

const skillCategories = [
  {
    title: 'Frontend',
    skills: [
      { name: 'HTML5', icon: html5Icon },
      { name: 'CSS3', icon: css3Icon },
      { name: 'JavaScript', icon: javascriptIcon },
      { name: 'TypeScript', icon: typescriptIcon },
      { name: 'React', icon: reactIcon },
      { name: 'Angular', icon: angularIcon },
      { name: 'Vue', icon: vueIcon },
      { name: 'Astro', icon: astroIcon },
    ],
  },
  {
    title: 'Backend',
    skills: [
      { name: 'Express', icon: expressIcon },
      { name: 'NestJS', icon: nestjsIcon },
      { name: 'Django', icon: djangoIcon },
      { name: 'PHP', icon: phpIcon },
      { name: 'PostgreSQL', icon: postgresqlIcon },
      { name: 'Redis', icon: redisIcon },
      { name: 'Node.js', icon: nodejsIcon },
      { name: 'MongoDB', icon: mongodbIcon },
      { name: 'Python', icon: pythonIcon },
    ],
  },
  {
    title: 'Mobile',
    skills: [
      { name: 'Flutter', icon: flutterIcon },
      { name: 'Dart', icon: dartIcon },
    ],
  },
  {
    title: 'CI/CD - DevOps',
    skills: [
      { name: 'GitLab CI', icon: gitlabciIcon },
      { name: 'Jenkins', icon: jenkinsIcon },
      { name: 'GitLab', icon: gitlabIcon },
      { name: 'Docker', icon: dockerIcon },
    ],
  },
]
---

<section class='relative bg-white text-black overflow-hidden min-h-screen py-23'>
  <Container maxWidth='xl'>
    <img
      src={backgroundBlobs.src}
      alt='Fondo decorativo'
      class='absolute inset-0 z-0 w-full h-full object-cover pointer-events-none'
      aria-hidden='true'
    />

    <div class='relative z-10 container'>
      <h2 class='std__title tracking-tight text-black'>Skills</h2>

      <div class='space-y-9'>
        {
          skillCategories.map((category) => (
            <div class='space-y-3'>
              <h3 class='text-3xl font-bold uppercase tracking-wider text-black'>{category.title}</h3>

              <div class='flex flex-wrap gap-4 items-center'>
                {category.skills.map((skill) => (
                  <div
                    class='std__shadow bg-gray-200 rounded-xl shadow-lg p-2
                    w-20 h-20 flex items-center justify-center
                    hover:scale-105 transition-transform duration-200'
                  >
                    <img src={skill.icon.src} alt={skill.name} class='w-14 h-14 object-contain' loading='lazy' />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  @reference 'tailwindcss';

  img.object-contain {
    max-width: 100%;
    max-height: 100%;
  }
</style>
